{
  "include": [
    "packages/core/src/catalog.ts",
    "packages/core/src/index.ts",
    "packages/cli/src/**/*.ts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true
  }
}
